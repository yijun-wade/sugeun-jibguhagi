{
  "buildCommand": "npx vite build && node scripts/inject-home-shell.mjs",
  "devCommand": "npx vite --port $PORT",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/trade.js": {
      "regions": [
        "icn1"
      ]
    },
    "api/search.js": {
      "regions": [
        "icn1"
      ]
    },
    "api/stories.js": {
      "regions": [
        "icn1"
      ]
    },
    "api/vibe.js": {
      "regions": [
        "icn1"
      ],
      "maxDuration": 30
    },
    "api/saju.js": {
      "regions": [
        "icn1"
      ],
      "maxDuration": 60
    },
    "api/saju-confirm.js": {
      "regions": [
        "icn1"
      ],
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/apt/:kaptCode",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|meta-externalagent|meta-externalfetcher|kakaotalk|kakaotalk-scrap|twitterbot|telegrambot|whatsapp|slackbot|discordbot|skypeuripreview|linkedinbot|bingbot|googlebot|naverbot|yeti|duckduckbot|applebot|msnbot|baiduspider|yandexbot|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-user|claude-searchbot|anthropic-ai|perplexitybot|perplexity-user|bytespider|ccbot|amazonbot|cohere-ai|duckassistbot|youbot|diffbot|petalbot|imagesiftbot|timpibot|semrushbot|ahrefsbot|mj12bot|dotbot).*"
        }
      ],
      "destination": "/api/apt?kaptCode=:kaptCode&prerender=1"
    },
    {
      "source": "/((?!api/|.well-known/).*)",
      "destination": "/index.html"
    }
  ]
}
